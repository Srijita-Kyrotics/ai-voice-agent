# OpenAI API Key (if using GPT)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Selection (options: openai, local)
LLM_PROVIDER=openai

# Local Llama API (if using Ollama)
LOCAL_LLM_URL=http://localhost:11434/v1

# Models
WHISPER_MODEL=base
LLM_MODEL=gpt-4o-mini
TTS_MODEL=en_US-lessac-medium

# Paths
INPUT_AUDIO_DIR=data/input_audio
OUTPUT_AUDIO_DIR=data/output_audio
